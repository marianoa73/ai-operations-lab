# Parámetros de todo el laboratorio en una sola Raspberry Pi. Copiar a ~/.config/ai-lab/ai-lab.env y ajustar.
# No poner claves acá: cada herramienta guarda las suyas con su propio inicio de sesión.

# --- Consolas (src/consoles.sh): <sesión>:<comando>, separadas por ';'
CONSOLES='claude:claude;codex:codex;opencode:opencode'
WORKDIR=/home/USUARIO/trabajo

# --- Delegación (src/delegate.sh)
OUT_DIR=/home/USUARIO/trabajo/respuestas
# IDLE_PATTERN: texto que cada herramienta muestra con la caja de entrada vacía (se ajusta por herramienta)

# --- Página de monitoreo (src/monitor.py)
MONITOR_SESSIONS=claude,codex,opencode
MONITOR_LINES=24
MONITOR_REFRESH=30
MONITOR_OUT=/var/lib/ai-lab/monitor/index.html
MONITOR_PAUSE=/home/USUARIO/.config/ai-lab/monitor.pause

# --- Publicación (examples/caddy/Caddyfile)
LAB_DOMAIN=lab.example.com
MONITOR_USER=admin
# Hash generado con: caddy hash-password
MONITOR_PASS_HASH=PEGAR_EL_HASH

# --- Modelo propio (en OTRO equipo de la red; ver docs/local-model.md)
OLLAMA_URL=http://192.168.1.50:11434
